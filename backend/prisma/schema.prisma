generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String?             @unique
  password           String?
  name               String?
  balance            Float               @default(0)
  isEmailVerified    Boolean             @default(false)
  createdAt          DateTime            @default(now())
  budgets            Budgets[]
  categories         Category[]
  chatMessages       ChatMessage[]
  chatSessions       ChatSession[]
  emailVerifications EmailVerification[]
  goals              Goals[]
  oauthAccounts      OAuthAccount[]
  refreshTokens      RefreshToken[]
  transactions       Transaction[]
  Icon               Icon[]

  @@index([id, email])
}

model OAuthAccount {
  id             Int       @id @default(autoincrement())
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  otpHash   String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          Int              @id @default(autoincrement())
  type        TransactionType?
  description String?
  amount      Float
  receipt     String?
  toAccount   String?
  fromAccount String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  userId      Int
  categoryId  Int
  category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Category {
  id           Int             @id @default(autoincrement())
  name         String
  type         TransactionType
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  userId       Int?
  iconId       Int
  icon         Icon            @relation(fields: [iconId], references: [id], onDelete: Cascade)
  user         User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Icon {
  id          Int        @id @default(autoincrement())
  url         String
  description String?
  userId      Int?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories  Category[]
}

model Goals {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  amount        Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budgets {
  id            Int       @id @default(autoincrement())
  name          String
  amount        Float
  currentAmount Float     @default(0)
  frequency     Frequency
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  userId        Int
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatSession {
  id        Int           @id @default(autoincrement())
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  userId    Int
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        Int         @id @default(autoincrement())
  role      String
  content   String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  userId    Int
  sessionId Int
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Stock {
  id                Int       @id @default(autoincrement())
  symbol            String    @unique
  name              String?
  instrumentType    String?
  securityType      String?
  status            String?
  marketStatus      String?
  last              Float?
  high              Float?
  low               Float?
  average           Float?
  change            Float?
  percentChange     Float?
  percentYield      Float?
  pe                Float?
  pbv               Float?
  eps               Float?
  aumSize           Float?
  inav              Float?
  theoretical       Float?
  exercisePrice     Float?
  exerciseRatio     Float?
  maturityDate      DateTime?
  lastTradingDate   DateTime?
  toLastTrade       Float?
  totalBuyVolume    Int?
  totalSellVolume   Int?
  totalNoSideVolume Int?
  totalVolume       Int?
  underlying        String?
  underlyingPrice   Float?
  moneyness         Float?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  exchange          String?
  impliedVolatility Float?
  intrinsicValue    Float?

  @@index([symbol])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum Frequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}
