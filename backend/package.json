{
  "name": "backend",
  "version": "1.0.50",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "bun run --watch src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist",
    "start": "bun src/index.ts",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write ."
  },
  "paths": {
    "@/*": [
      "./src/*"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.962.0",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@google-cloud/vision": "^5.3.4",
    "@qdrant/js-client-rest": "^1.16.2",
    "arctic": "^3.7.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "latest",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.9.2",
    "nodemailer": "^7.0.12",
    "openai": "^6.16.0",
    "pino": "^10.1.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.7",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/nodemailer": "^7.0.4",
    "@types/uuid": "^11.0.0",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.8"
